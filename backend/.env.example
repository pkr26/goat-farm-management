# Copy to backend/.env and adjust. Every setting is a GOATFARM_* env var;
# .env is read relative to backend/ regardless of where you launch from.
# Defaults (shown here) are dev-friendly. See backend/app/core/config.py.

# --- File-delivered secrets (2026-10-01 audit, 09-1) -------------------------
# Every environment-borne secret below may instead be delivered from a
# read-only mounted file: set the corresponding *_FILE variable to the
# file's absolute container path and the app reads the secret's trimmed
# content from it, exactly like the JWT PEM paths and the database CA.
# docker-compose.production.yml mounts such files under /run/secrets/app so
# the values stay out of `docker inspect` and /proc/<pid>/environ. A set
# *_FILE path takes precedence over the plain variable; the plain variables
# keep working, and a configured path that is missing, unreadable, or blank
# fails closed at boot. Leave these unset for plain env-var delivery.
# GOATFARM_DATABASE_URL_FILE=/run/secrets/app/database_url
# GOATFARM_MIGRATION_DATABASE_URL_FILE=/run/secrets/app/migration_database_url
# GOATFARM_IDEMPOTENCY_REQUEST_HMAC_SECRET_FILE=/run/secrets/app/idempotency_request_hmac_secret
# GOATFARM_TOTP_ENCRYPTION_KEY_FILE=/run/secrets/app/totp_encryption_key
# GOATFARM_S3_ACCESS_KEY_ID_FILE=/run/secrets/app/s3_access_key_id
# GOATFARM_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/app/s3_secret_access_key
# GOATFARM_SCREENING_ANTHROPIC_API_KEY_FILE=/run/secrets/app/screening_anthropic_api_key
# GOATFARM_SCREENING_OPENAI_API_KEY_FILE=/run/secrets/app/screening_openai_api_key
# GOATFARM_MSG91_AUTH_KEY_FILE=/run/secrets/app/msg91_auth_key

# --- Database ---------------------------------------------------------------
GOATFARM_DATABASE_URL=postgresql+asyncpg://localhost:5432/goatfarm
# Use the asyncpg scheme exactly. Configure TLS with GOATFARM_DB_SSLMODE (not
# URL-level ssl/sslrootcert options); a matching legacy ?sslmode= value is
# normalized away before asyncpg opens the pool.
# Optional in development; REQUIRED in production. This Alembic-only identity
# has DDL rights while the long-running API credential above has none.
# GOATFARM_MIGRATION_DATABASE_URL=postgresql+asyncpg://migrator@localhost:5432/goatfarm
# TLS for the DB wire: disable | allow | prefer | require | verify-ca | verify-full
# Production requires "verify-full" so both the certificate chain and the
# database hostname are authenticated. "require" encrypts without authenticating
# the server when no root certificate is configured.
GOATFARM_DB_SSLMODE=disable
# Optional absolute path to a PEM CA bundle for a private managed/self-hosted
# PostgreSQL endpoint. With verify-ca/verify-full and this unset, the process
# uses its system CA store; set this when the database is signed by a private
# CA, mount the file read-only, and keep its hostname/FQDN in the DB URL so
# verify-full can validate it. This setting is invalid with non-verifying TLS
# modes (disable/allow/prefer/require).
# GOATFARM_DB_SSLROOTCERT_PATH=/run/secrets/goatfarm-postgres-ca.pem
GOATFARM_DB_POOL_SIZE=5
GOATFARM_DB_MAX_OVERFLOW=10
GOATFARM_DB_POOL_TIMEOUT=30
GOATFARM_DB_STATEMENT_TIMEOUT_MS=30000
# Separate finite per-statement budget for `alembic upgrade` (15 minutes).
# Raise only after measuring a production-shaped rehearsal. A populated
# database crossing a quiescence-required revision additionally refuses to
# proceed until the release job explicitly sets the one-shot acknowledgement.
GOATFARM_MIGRATION_STATEMENT_TIMEOUT_MS=900000
GOATFARM_MIGRATION_WRITES_QUIESCED=false
# Successful Idempotency-Key responses are replayable for seven days. Expired
# rows are deleted by finite lock-skipping background batches.
GOATFARM_IDEMPOTENCY_RETENTION_HOURS=168
GOATFARM_IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600
GOATFARM_IDEMPOTENCY_CLEANUP_BATCH_SIZE=500
GOATFARM_IDEMPOTENCY_CLEANUP_MAX_BATCHES=10
# Per-actor ceiling on live (unexpired) idempotency records. The purge loop is
# throughput-capped, so without this a client minting a fresh key per request
# could grow the shared table faster than cleanup drains it.
GOATFARM_IDEMPOTENCY_MAX_OPEN_RECORDS_PER_ACTOR=1000
# Development-only fallback. Production rejects this known value and requires
# a stable, independently generated >=32-character secret injected by the
# deployment secret manager. Never reuse a JWT, database, or password secret.
GOATFARM_IDEMPOTENCY_REQUEST_HMAC_SECRET=development-only-idempotency-hmac-secret-change-me
# JSON array of verification-only secrets during rotation (maximum 3). Production
# also rejects the known development fallback from this previous-key list.
GOATFARM_IDEMPOTENCY_REQUEST_HMAC_PREVIOUS_SECRETS=[]
GOATFARM_LEGACY_REPAIR_INTERVAL_SECONDS=3600
GOATFARM_LEGACY_REPAIR_FARM_BATCH_SIZE=25
GOATFARM_LEGACY_REPAIR_TASK_BATCH_SIZE=500
GOATFARM_LEGACY_REPAIR_MAX_BATCHES=10
# Recurring husbandry duties are materialized by a short-interval background
# sweep (GET /api/tasks is read-only). The sweep pages the tenant list in
# finite keyset batches; a per-farm advisory lock inside the cadence service
# serializes any overlap with a concurrent sweep.
GOATFARM_CADENCE_MATERIALIZATION_INTERVAL_SECONDS=300
GOATFARM_CADENCE_MATERIALIZATION_FARM_BATCH_SIZE=100
GOATFARM_CADENCE_MATERIALIZATION_MAX_BATCHES=10
# Pending duties linked to sold/dead/culled animals are hidden immediately and
# retired asynchronously in finite batches.
GOATFARM_INACTIVE_ANIMAL_TASK_CLEANUP_INTERVAL_SECONDS=60
GOATFARM_INACTIVE_ANIMAL_TASK_CLEANUP_BATCH_SIZE=500
GOATFARM_INACTIVE_ANIMAL_TASK_CLEANUP_MAX_BATCHES=10
# A deleted User tombstone revokes access immediately. Retained membership
# audit anchors converge to inactive in finite lock-skipping batches.
GOATFARM_DELETED_MEMBERSHIP_CLEANUP_INTERVAL_SECONDS=60
GOATFARM_DELETED_MEMBERSHIP_CLEANUP_BATCH_SIZE=500
GOATFARM_DELETED_MEMBERSHIP_CLEANUP_MAX_BATCHES=10
# Default-on data retention: first commits an exact-key deletion tombstone,
# then permanently removes and verifies every object version, and only then
# finalizes its relational chain. Failed/ambiguous attempts remain durable for
# retry. It also ages orphaned batches, budget receipts, settled notification
# ledgers, and terminal duties. weight_records/feeding_records remain long-term.
GOATFARM_RETENTION_SWEEP_ENABLED=true
GOATFARM_RETENTION_SWEEP_INTERVAL_SECONDS=86400
GOATFARM_RETENTION_SCREENING_DAYS=180
GOATFARM_RETENTION_SCREENING_BATCH_DAYS=365
GOATFARM_RETENTION_SCREENING_BUDGET_DAYS=90
GOATFARM_RETENTION_NOTIFICATION_DAYS=400
GOATFARM_RETENTION_TERMINAL_TASK_DAYS=365
GOATFARM_RETENTION_DELETE_BATCH_SIZE=500
GOATFARM_RETENTION_FARM_BATCH_SIZE=100
GOATFARM_RETENTION_MAX_BATCHES_PER_FARM=4
GOATFARM_RETENTION_LOCK_TIMEOUT_MS=250
GOATFARM_RETENTION_STATEMENT_TIMEOUT_MS=5000
# App-level backstop; configure the edge proxy to the same or a smaller limit.
GOATFARM_MAX_REQUEST_BODY_BYTES=1048576
GOATFARM_MAX_REQUEST_TARGET_BYTES=8192

# --- Backup / restore scripts ------------------------------------------------
# Local development may create an unsigned plaintext dump. Production and any
# S3/off-site backup fail closed unless both GPG values are configured; use
# complete, immutable key fingerprints rather than email/key-name selectors.
# These script-only values must be exported by the backup/restore job, not
# uncommented in backend/.env (application settings intentionally reject
# unknown keys).
# GOATFARM_BACKUP_KEEP=30
# GOATFARM_BACKUP_GPG_RECIPIENT=RECIPIENT_KEY_FINGERPRINT
# GOATFARM_BACKUP_GPG_SIGNER_FINGERPRINT=SIGNING_KEY_FINGERPRINT
# GOATFARM_BACKUP_S3_URI=s3://company-backups/goatfarm
# Production requires a fresh unbound whole-system inventory; backup.sh binds
# it to the exact archive. See recovery_inventory.py capture --help.
# GOATFARM_RECOVERY_INVENTORY_FILE=/secure/goatfarm-recovery-unbound.json
# GOATFARM_RECOVERY_INVENTORY_MAX_AGE_HOURS=26
# Restore independently pins the expected signer of every .gpg artifact.
# scripts/libpq_url.py accepts postgres://, postgresql:// or
# postgresql+asyncpg:// and always hands psql/pg_restore a normalized,
# password-free postgresql:// URL. Use the async driver scheme so the very same
# value can be reused verbatim as GOATFARM_MIGRATION_DATABASE_URL for the
# post-restore `alembic upgrade head`, which builds an async engine.
# GOATFARM_RESTORE_DATABASE_URL=postgresql+asyncpg://restore@host/goatfarm_restore_test
# GOATFARM_RESTORE_GPG_SIGNER_FINGERPRINT=SIGNING_KEY_FINGERPRINT
# GOATFARM_RECOVERY_INVENTORY_RESTORE_MAX_AGE_HOURS=744
# GOATFARM_RESTORE_CONFIRM is intentionally supplied only for a restore command.

# --- Environment / production safety ----------------------------------------
# development | production. In production the app REFUSES to boot unless
# cookie_secure=true, CORS is an exact non-loopback HTTPS origin, DB TLS uses
# verify-full, and min_password_length>=12. /docs, /redoc, /openapi.json are
# not served.
GOATFARM_ENVIRONMENT=development
GOATFARM_COOKIE_SECURE=false
# Development uses goatfarm_refresh. Production automatically upgrades that
# default to __Host-goatfarm_refresh; any custom production name must also
# start with __Host-. The API always sets Secure, HttpOnly, SameSite=Lax and
# Path=/ in production and never sets Domain.
GOATFARM_REFRESH_COOKIE_NAME=goatfarm_refresh
GOATFARM_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
# HTTP Host header allowlist (not URLs and normally the API host, not the SPA
# host). Production rejects wildcard/loopback values. `*.example.com` is valid.
# When Next proxies through Docker Compose, also admit its exact internal
# destination hostname `backend`; docker-compose.yml supplies this by default.
GOATFARM_ALLOWED_HOSTS=["localhost", "127.0.0.1", "test", "testserver"]
GOATFARM_MAX_TEAM_MEMBERS_PER_FARM=200
GOATFARM_MAX_ROLES_PER_FARM=50
GOATFARM_MAX_SIMULATION_SCENARIOS_PER_FARM=25
GOATFARM_MAX_PLANNER_PLANS_PER_FARM=25
GOATFARM_MAX_PENDING_MANUAL_TASKS_PER_FARM=5000
GOATFARM_MAX_ACCOUNT_AFFILIATIONS_PER_RESPONSE=500

# --- Auth / JWT ---------------------------------------------------------------
# Signing algorithm is fixed (RS256); the knob exists for audited rotation only:
# GOATFARM_JWT_ALGORITHM=RS256
# RS256 keypair auto-generates only in development: new generations land in
# ~/.cache/goatfarm/keys ($XDG_CACHE_HOME/goatfarm/keys when set), outside the
# repository tree; an existing backend/keys/ pair is still honored when already
# present. Production fails at startup unless both configured files exist,
# parse as a matching RSA pair, and use at least 2048 bits. Mount stable secrets,
# then configure their absolute paths, for example:
# GOATFARM_JWT_PRIVATE_KEY_PATH=/run/secrets/goatfarm_jwt_private.pem
# GOATFARM_JWT_PUBLIC_KEY_PATH=/run/secrets/goatfarm_jwt_public.pem
# JSON array of verification-only public PEM paths retained or pre-staged
# during rotation (maximum 3). Never list private keys here.
GOATFARM_JWT_PREVIOUS_PUBLIC_KEY_PATHS=[]
# TOTP shared secrets use a separate stable AES-256 key; never derive or reuse
# a JWT/database/password secret. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# It is REQUIRED in production. Set it on every API instance before a JWT
# signing-key cutover, run scripts/rekey_totp_secrets.py --apply while the old
# signer is still active, and retain it unchanged throughout the JWT rotation.
# GOATFARM_TOTP_ENCRYPTION_KEY=replace-with-43-char-base64url-secret
# JSON array of prior TOTP keys during an intentional TOTP-key rotation
# (maximum 3). New ciphertext always uses the current key.
GOATFARM_TOTP_ENCRYPTION_PREVIOUS_KEYS=[]
GOATFARM_JWT_ISSUER=goatfarm-api
GOATFARM_JWT_AUDIENCE=goatfarm-web
# Access TTL is capped at one day; refresh TTL at one year.
GOATFARM_ACCESS_TOKEN_TTL_SECONDS=1800
GOATFARM_REFRESH_TOKEN_TTL_SECONDS=1209600
GOATFARM_REFRESH_SESSION_CLEANUP_INTERVAL_SECONDS=3600
GOATFARM_REFRESH_SESSION_CLEANUP_BATCH_SIZE=500
GOATFARM_REFRESH_SESSION_CLEANUP_MAX_BATCHES=10
GOATFARM_REFRESH_MAX_FAMILIES_PER_USER=10
GOATFARM_REFRESH_MAX_SESSIONS_PER_FAMILY=1024
# Concurrent same-origin tabs may replay one just-rotated cookie only inside
# this narrow idempotency window; later reuse revokes the rotation family.
GOATFARM_REFRESH_REUSE_GRACE_SECONDS=3
# Development default. Production validation requires at least 12.
GOATFARM_MIN_PASSWORD_LENGTH=8

# Argon2id parameters (only changeable via env, never at runtime). Startup
# rejects time>6, memory>131072 KiB, parallelism>8, hash length>64, and memory
# below 8 KiB per parallel lane before attempting the dummy hash. Production
# additionally requires time>=2, memory>=19456 KiB, and hash length>=32.
GOATFARM_ARGON2_TIME_COST=3
GOATFARM_ARGON2_MEMORY_COST=65536
GOATFARM_ARGON2_PARALLELISM=4
GOATFARM_ARGON2_HASH_LEN=32
GOATFARM_ARGON2_WORKER_THREADS=2
# PBKDF2 padding spent on every rejected login so aggregate work cannot reveal
# which kind of stored hash was looked up. Must cover the highest PBKDF2
# iteration count actually present among imported legacy hashes (this
# repository's own history tops out at 50,000); deployments that import
# costlier hashes must raise it together with their import audit.
GOATFARM_REJECTED_LOGIN_PBKDF2_WORK_BUDGET=50000

# --- Rate limiting ------------------------------------------------------------
# In-memory, PER PROCESS: run a single uvicorn worker (see README). These limits
# also bound the combined worker-create/password-reset Argon budget per owner.
GOATFARM_AUTH_RATE_LIMIT_ENABLED=true
GOATFARM_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
GOATFARM_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Which limiter implementation backs the auth ceilings. Only "memory" exists
# today; the setting exists so a deployment accidentally pointed at an
# unknown backend fails at boot instead of silently running unthrottled.
GOATFARM_RATE_LIMIT_BACKEND=memory

# --- Observability --------------------------------------------------------------
# Prometheus exposition at /metrics (routed only on the internal network by
# the compose edge; see README observability section). false removes the route.
GOATFARM_METRICS_ENABLED=true
# Public scraping is development-only; production always requires a private
# independent bearer credential of at least 32 characters for exposition.
GOATFARM_METRICS_PUBLIC_ENABLED=true
# GOATFARM_METRICS_BEARER_TOKEN_FILE=/run/secrets/app/metrics_bearer_token

# Comma-separated IPs/CIDRs of trusted reverse proxies; empty trusts nothing.
# Startup rejects a hostname (uvicorn can never match one against a peer
# address, so it would silently trust nothing) and rejects "*" or any /0
# network (uvicorn treats those as always-trust, making X-Forwarded-For — and
# therefore every per-IP auth ceiling and throttling log line — spoofable).
# Name the proxy's own addresses, not the range it sits in.
GOATFARM_TRUSTED_PROXY_HOSTS=

# Deliberately NOT the code default (10): deployment guidance from the
# playbook's 20-farm owner operation (ITEM 0) is 25, giving that operation
# headroom. Local development can leave this unset to use the code default.
GOATFARM_MAX_FARMS_PER_USER=25

# --- Notifications (ITEM 4) ---------------------------------------------------
# Off by default. Enable only with a provider: console logs instead of
# sending (development), msg91 delivers SMS (requires the auth key; the
# production validator refuses notifications_enabled=true without it).
GOATFARM_NOTIFICATIONS_ENABLED=false
GOATFARM_NOTIFICATIONS_PROVIDER=console
GOATFARM_MSG91_AUTH_KEY=
GOATFARM_MSG91_SENDER_ID=HERDLY
# Optional DLT template id for the MSG91 flow API (unset = template-free
# dlt_manual route).
GOATFARM_MSG91_TEMPLATE_ID=
# Farm-local morning minute for the daily duties digest.
GOATFARM_NOTIFICATIONS_DIGEST_HOUR=6
GOATFARM_NOTIFICATIONS_DIGEST_MINUTE=30
GOATFARM_NOTIFICATIONS_FARM_DAILY_CAP=50
GOATFARM_NOTIFICATIONS_QUIET_START_HOUR=21
GOATFARM_NOTIFICATIONS_QUIET_END_HOUR=6
# Transport-failure retry: attempts per send (1 = no retry) and the linear
# backoff step between them (seconds).
GOATFARM_NOTIFICATIONS_SEND_RETRY_ATTEMPTS=2
GOATFARM_NOTIFICATIONS_SEND_RETRY_BACKOFF_SECONDS=2
# Bounded-batch ceiling for the notifications loop's farm scans.
GOATFARM_NOTIFICATIONS_LOOP_BATCH_SIZE=100
# Bounded provider I/O: global across notification classes and per farm.
GOATFARM_NOTIFICATIONS_DELIVERY_CONCURRENCY=8
GOATFARM_NOTIFICATIONS_PER_FARM_DELIVERY_CONCURRENCY=2

# --- Worker tablet PINs (ITEM 2) ----------------------------------------------
# Minimum PIN length for tablet sign-in (production requires 12).
GOATFARM_WORKER_PIN_MIN_LENGTH=4
GOATFARM_WORKER_PIN_RATE_LIMIT_MAX_ATTEMPTS=10
GOATFARM_WORKER_PIN_RATE_LIMIT_WINDOW_SECONDS=300
# The unauthenticated worker roster powers the tablet's tap-your-name screen
# and is an enumeration oracle by documented design (names only, throttled).
# Privacy-safe default is false. Explicitly enable only on a provisioned shared
# tablet deployment; the endpoint otherwise answers 404 and tap-to-sign-in is
# unavailable (there is intentionally no manual membership-id entry).
GOATFARM_WORKER_ROSTER_ENABLED=false

# --- Disease screening (daily S3 photo batches -> gate model) ---------------
# Off by default: without S3 + provider credentials the feature stays inert.
# Photos arrive as daily uploads under
#   <prefix>/<farm_id>/<YYYY-MM-DD>/<filename>
# and are screened by one gate model; healthy verdicts stop the cascade.
GOATFARM_SCREENING_ENABLED=false

# S3-compatible storage. Leave S3_ENDPOINT_URL unset for AWS proper; set it
# for MinIO / Cloudflare R2 / LocalStack.
GOATFARM_S3_ENDPOINT_URL=
GOATFARM_S3_REGION=us-east-1
GOATFARM_S3_BUCKET=
GOATFARM_S3_ACCESS_KEY_ID=
GOATFARM_S3_SECRET_ACCESS_KEY=
GOATFARM_SCREENING_S3_PREFIX=raw

# Worker cadence and per-cycle intake bound (backlogs drain over cycles).
GOATFARM_SCREENING_POLL_INTERVAL_SECONDS=300
GOATFARM_SCREENING_MAX_IMAGES_PER_CYCLE=50
# API-side post-presign privacy cleanup. Each tick claims at most
# BATCH_SIZE * MAX_BATCHES expired raw-object obligations with SKIP LOCKED;
# failures retain durable, exponentially backed-off retry state.
GOATFARM_SCREENING_RAW_CLEANUP_INTERVAL_SECONDS=60
GOATFARM_SCREENING_RAW_CLEANUP_BATCH_SIZE=25
GOATFARM_SCREENING_RAW_CLEANUP_MAX_BATCHES=4
# VLM cost scales with pixels: images are resized to this longest edge before
# any bytes are sent to a provider.
GOATFARM_SCREENING_IMAGE_MAX_EDGE_PX=1568
# Presigned upload forms and image URLs handed to the review UI live this
# long. Uploads are policy-bounded to a declared JPEG/PNG and 1..25 MiB;
# the API also permits at most 5 open batches, 100 images per batch, and 250
# in-flight images per farm (fixed server-side safety ceilings).
GOATFARM_SCREENING_PRESIGN_EXPIRY_SECONDS=900

# The worker writes an atomic successful-cycle heartbeat here. Its container
# health probe rejects a stale or error status; keep the age at least 30
# seconds greater than the polling interval.
GOATFARM_SCREENING_WORKER_HEARTBEAT_PATH=/tmp/goatfarm-screening-worker.json
GOATFARM_SCREENING_WORKER_HEALTH_MAX_AGE_SECONDS=900
# A whole-cycle exception (for example, lost database or object-store
# connectivity) is retried briefly, then exits nonzero after this many
# consecutive failures so Compose's restart policy replaces the worker.
# Per-image/provider verdict errors are recorded by the pipeline and do not
# count toward this limit.
GOATFARM_SCREENING_WORKER_MAX_CONSECUTIVE_CYCLE_FAILURES=3

# Phase 1 gate provider: "anthropic" (Messages API) or "openai_compatible"
# (GLM, GPT, any OpenAI-shaped endpoint). Phase 2 rotates over both.
GOATFARM_SCREENING_PROVIDER=anthropic
GOATFARM_SCREENING_ANTHROPIC_BASE_URL=https://api.anthropic.com
GOATFARM_SCREENING_ANTHROPIC_API_KEY=
GOATFARM_SCREENING_ANTHROPIC_MODEL=claude-sonnet-4-5
GOATFARM_SCREENING_OPENAI_BASE_URL=https://api.openai.com/v1
GOATFARM_SCREENING_OPENAI_API_KEY=
GOATFARM_SCREENING_OPENAI_MODEL=gpt-5
# A gate call that exceeds this is abandoned and retried next cycle.
GOATFARM_SCREENING_PROVIDER_TIMEOUT_SECONDS=120
# A PROCESSING claim whose image row has not been touched for this long is
# treated as crashed and re-claimed (the pipeline refreshes the row after
# every completed stage). Boot-time cross-validation requires this horizon to
# cover one worst-case cascade — (2 x providers + 6) x the provider timeout
# above — so raise the two together (2026-09-28 audit, F3).
GOATFARM_SCREENING_STALE_PROCESSING_AFTER_SECONDS=1800

# Per-farm daily provider-call budget (ITEM 6 cost control): a farm whose
# ScreeningRun count for the UTC day has reached this stays parked in
# PENDING until tomorrow instead of accruing model spend.
GOATFARM_SCREENING_DAILY_CALL_BUDGET_PER_FARM=400

# Phase 2 round-robin: ordered provider list (JSON array). The day's ordinal
# picks the primary gate provider (Monday claude, Tuesday glm, ... — zero
# stored state); the next entry serves the flagged-image cross-check and the
# failure fallback. Empty keeps the single-provider behavior above.
# Each entry: kind (anthropic|openai_compatible), name (slug), model, api_key,
# optional base_url for openai_compatible endpoints.
GOATFARM_SCREENING_PROVIDER_ROTATION=
# Example:
# GOATFARM_SCREENING_PROVIDER_ROTATION=[{"kind":"anthropic","name":"claude","model":"claude-sonnet-4-5","api_key":"sk-..."},{"kind":"openai_compatible","name":"glm","base_url":"https://open.bigmodel.cn/api/paas/v4","model":"glm-4.6v","api_key":"..."}]

# Phase 3 multi-goat detection: one detection call per photo splits it into
# per-goat crops, each screened independently. Zero detected goats (or a
# failed detection call) falls back to screening the whole photo.
GOATFARM_SCREENING_CROP_DETECTION_ENABLED=true
# Cap on goats screened per photo; extra boxes are ignored (a photo claiming
# 30 goats is a detection hallucination).
GOATFARM_SCREENING_MAX_CROPS_PER_IMAGE=8
