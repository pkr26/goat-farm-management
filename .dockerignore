.git
.gitignore
# The root build context is used by the backend image. Git ignores these
# operator-owned files, but Docker does not consult .gitignore before sending
# the full context to a local or remote builder.
.env
.env.*
backups/
*.dump
*.dump.gpg
*.dump.sha256
*.dump.gpg.sha256
AUDIT.md
README.md
shared
frontend
backend/.venv
backend/.pytest_cache
backend/.mypy_cache
backend/.ruff_cache
backend/.env
backend/keys
backend/tests
backend/scripts/*
!backend/scripts/healthcheck.py
**/__pycache__
.dockerignore
docker-compose.yml
.github
