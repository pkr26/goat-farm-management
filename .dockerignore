.git
.gitignore
# The root build context is used by the backend image. Git ignores these
# operator-owned files, but Docker does not consult .gitignore before sending
# the full context to a local or remote builder.
.env
.env.*
secrets/
backups/
*.dump
*.dump.gpg
*.dump.sha256
*.dump.gpg.sha256
AUDIT.md
AUDIT_AND_IMPLEMENTATION_PLAYBOOK.md
AUDIT_REPORT_2026-09-28.md
MUTATION_TESTING_REPORT.md
README.md
shared
frontend
backend/.venv
backend/.pytest_cache
backend/.mypy_cache
backend/.ruff_cache
# Root-level tool caches/mutation artifacts are context bloat only: the
# Dockerfile COPYs explicit backend paths, so none of these can be needed
# by the image (2026-09-28 audit, infra/docs).
.mypy_cache
.ruff_cache
.zcode
backend/mutation
backend/goatfarm_backend.egg-info
backend/.env
backend/keys
backend/coverage.xml
backend/htmlcov
backend/tests
backend/scripts/*
!backend/scripts/healthcheck.py
!backend/scripts/screening_worker_healthcheck.py
!backend/scripts/compose_env_guard.py
!backend/scripts/rekey_totp_secrets.py
!backend/scripts/totp_breakglass.py
**/__pycache__
.dockerignore
docker-compose.yml
docker-compose.production.yml
docker-compose.override.yml
.github
audit_reports
coverage
frontend/coverage
frontend/test-results
frontend/reports
