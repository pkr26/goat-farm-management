# Production edge template. It is rendered by edge-entrypoint.sh after every
# value substituted below is validated; unlike the local Compose-inline
# template, this file deliberately contains literal nginx $variables.

# P2-15 (2026-09-20 audit): the mandated production topology terminates TLS
# in front of this edge, so $binary_remote_addr is ALWAYS the terminator's
# single loopback address — keying the auth zone on it put every user of
# /api/auth/* into one shared bucket (a cheap fleet-wide auth DoS, and
# self-DoS at shift-start bursts). The terminator owns the forwarded chain
# and APPENDS the connecting address to X-Forwarded-For, so the RIGHTMOST
# entry is the real client as the trusted terminator saw it. Key on that:
# entries a client injects can only land to the LEFT of the appended hop, so
# unlike the first entry (which a client controls wholesale) the last entry
# cannot be rotated to mint fresh buckets or pinned onto a victim. This is
# the same right-to-left trust walk the backend's ProxyHeadersMiddleware
# applies to the identical header. A missing/empty header (direct loopback
# health probe) falls back to the socket address.
map $http_x_forwarded_for $auth_flood_key {
    default $binary_remote_addr;
    ~^(?:.*,)?[ \t]*(?<client_addr>[^, \t]+)[ \t]*$ $client_addr;
}
limit_req_zone $auth_flood_key zone=auth_flood:10m rate=__GOATFARM_EDGE_AUTH_RATE__;

server {
    listen 3000;
    server_name _;

    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto __GOATFARM_EDGE_PUBLIC_SCHEME__;
    proxy_http_version 1.1;
    client_max_body_size __GOATFARM_EDGE_MAX_BODY_SIZE__;
    server_tokens off;

    # Security response headers: the application owns the complete set on
    # every proxied response — the next.config.ts baseline (COOP/CORP/
    # Permissions-Policy included) plus the per-request nonce CSP from the
    # frontend's proxy.ts (M-1, 2026-09-20): a nonce policy cannot be
    # emitted here because the edge cannot mint and embed the nonce into
    # the rendered HTML the way the render boundary can. The API sets its
    # own baseline on /api responses. A server-level `add_header ... always`
    # here stamped a second, partial set onto those same proxied responses —
    # duplicate X-Frame-Options/X-Content-Type-Options and a CONFLICTING
    # Referrer-Policy (edge no-referrer vs the SPA's
    # strict-origin-when-cross-origin) on every response (2026-09-28 audit,
    # F1). The edge therefore adds its minimal set ONLY to the responses
    # nginx itself generates: the limit_req 429 (error_page-routed through
    # @auth_flood_rejected below) and /edge-healthz. Upstream-failure pages
    # keep nginx's built-in error bodies. Deployment S3/MinIO origins reach
    # the frontend container as GOATFARM_CSP_IMG_ORIGINS /
    # GOATFARM_CSP_CONNECT_ORIGINS env (validated at edge boot by
    # edge-entrypoint.sh); this template no longer renders them. HSTS: the
    # entrypoint asserts an HTTPS terminator in production, so the
    # edge-generated responses carry it (the app adds its own HSTS to
    # production builds).

    # Docker's embedded resolver + variable proxy_pass forces lookup after a
    # routine backend/frontend container recreation instead of caching a dead
    # container IP for the nginx worker lifetime.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Container-local liveness endpoint, answered by nginx itself (no
    # upstream) and reachable only from the container's own loopback. One of
    # the two response types this server generates itself, so it carries the
    # edge's minimal header set (F1).
    location = /edge-healthz {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        allow 127.0.0.1;
        deny all;
        access_log off;
        return 200 "ok\n";
    }

    # No trailing slash (L-1, 2026-09-20 audit): the prefix form matches both
    # /api/auth and /api/auth/..., so the flood zone cannot be skipped by
    # dropping the slash on the exact parent path of every credential route.
    location /api/auth {
        limit_req zone=auth_flood burst=__GOATFARM_EDGE_AUTH_BURST__ nodelay;
        limit_req_status 429;
        # The 429 is generated by nginx, not the app: route it through the
        # named location below so the rejection carries the edge's minimal
        # header set while proxied responses keep only the app's headers
        # (2026-09-28 audit, F1).
        error_page 429 = @auth_flood_rejected;
        set $backend_upstream backend;
        proxy_pass http://$backend_upstream:8000$request_uri;
    }

    # Edge-generated limit_req rejection. This is the only other place
    # add_header may appear: nginx applies a location's add_header to
    # proxied responses as well, which is exactly the duplication/conflict
    # F1 removes, so proxied locations carry none.
    location @auth_flood_rejected {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        return 429 "rate limited\n";
    }

    location /api/ {
        set $backend_upstream backend;
        proxy_pass http://$backend_upstream:8000$request_uri;
    }

    location / {
        set $frontend_upstream frontend;
        proxy_pass http://$frontend_upstream:3000$request_uri;
    }
}
