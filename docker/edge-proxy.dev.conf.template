# Bound request floods before they reach the API. Rate and burst are
# validated by edge-entrypoint.sh. Behind an outer TLS terminator this local
# template shares one socket-address bucket; the API still limits each client.
limit_req_zone $binary_remote_addr zone=auth_flood:10m rate=__GOATFARM_EDGE_AUTH_RATE__;
server {
    listen 3000;
    server_name _;

    # Preserve the browser's Host: TrustedHostMiddleware validates it and
    # the SPA builds same-origin URLs from it. X-Forwarded-For is what
    # lets the API key its auth rate limits on the real client.
    # $host discards a non-default public port (notably Compose's :3000),
    # making FastAPI's canonical slash redirects point at the wrong
    # origin. HTTP/1.1+ supplies $http_host from Host/:authority, intact.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Never trust a client-supplied forwarding header. Compose's edge is
    # HTTP locally; a deployment with a trusted TLS terminator pins this
    # operator-controlled value to `https` in the root .env file.
    proxy_set_header X-Forwarded-Proto __GOATFARM_EDGE_PUBLIC_SCHEME__;
    proxy_http_version 1.1;
    # Keep this cap aligned with GOATFARM_MAX_REQUEST_BODY_BYTES.
    client_max_body_size __GOATFARM_EDGE_MAX_BODY_SIZE__;
    # Do not disclose the nginx version.
    server_tokens off;

    # Applications own security headers on proxied responses; the frontend
    # also creates and embeds its per-request CSP nonce. Adding headers
    # here would duplicate or conflict with upstream policies. The edge
    # adds its baseline only to /edge-healthz and auth-flood rejections.
    # Other edge errors use static nginx bodies without this baseline.
    # S3 origins reach the frontend via CSP env settings, validated at boot.
    # Local development uses HTTP and does not emit HSTS.

    # Re-resolve Docker service names after container recreation.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Container-loopback liveness; no upstream dependency.
    location = /edge-healthz {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        allow 127.0.0.1;
        deny all;
        access_log off;
        return 200 "ok\n";
    }

    # Match both /api/auth and its children so omitting a slash cannot bypass
    # the credential-endpoint flood limit.
    location /api/auth {
        limit_req zone=auth_flood burst=__GOATFARM_EDGE_AUTH_BURST__ nodelay;
        limit_req_status 429;
        # Edge-generated rejections receive the edge header policy.
        error_page 429 = @auth_flood_rejected;
        # Variable upstreams require the original URI and query explicitly.
        set $backend_upstream backend;
        proxy_pass http://$backend_upstream:8000$request_uri;
    }

    # Apply edge headers only to this locally generated rejection.
    location @auth_flood_rejected {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        # Match the API's conservative auth retry window.
        add_header Retry-After 300 always;
        return 429 "rate limited\n";
    }
    location /api/ {
        # Variable upstreams require the original URI and query explicitly.
        set $backend_upstream backend;
        proxy_pass http://$backend_upstream:8000$request_uri;
    }
    location / {
        set $frontend_upstream frontend;
        proxy_pass http://$frontend_upstream:3000$request_uri;
    }
}
