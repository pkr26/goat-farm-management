# RT-R-1: first-line flood shaping for the unauthenticated password
# endpoints. The backend's per-IP limiter (10 login attempts / 300 s)
# already bounds credential guessing; this zone keeps raw request floods
# off the single uvicorn worker before they can occupy its two Argon2
# slots. The default 5 r/s with burst 20 per client address is far above
# human login/refresh cadence (and refreshes carry no Argon2 cost) while
# capping an attacker at ~1/6th of the measured rejection throughput.
# Rate and burst are operator knobs: GOATFARM_EDGE_AUTH_RATE/_BURST reach
# this template through edge-entrypoint.sh, which grammar-validates them
# before rendering — hard-coded literals here used to discard the
# compose-forwarded values silently (2026-09-28 audit, F2). Caveat for the
# outer-TLS-terminator topology: this edge sees the terminator's address
# as $binary_remote_addr, so the zone's rate is AGGREGATE across all
# clients in that deployment. The backend's own X-Forwarded-For-keyed
# limiter remains per-client there; this zone is coarse flood shaping
# only.
limit_req_zone $binary_remote_addr zone=auth_flood:10m rate=__GOATFARM_EDGE_AUTH_RATE__;
server {
    listen 3000;
    server_name _;

    # Preserve the browser's Host: TrustedHostMiddleware validates it and
    # the SPA builds same-origin URLs from it. X-Forwarded-For is what
    # lets the API key its auth rate limits on the real client.
    # $host discards a non-default public port (notably Compose's :3000),
    # making FastAPI's canonical slash redirects point at the wrong
    # origin. HTTP/1.1+ supplies $http_host from Host/:authority, intact.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Never trust a client-supplied forwarding header. Compose's edge is
    # HTTP locally; a deployment with a trusted TLS terminator pins this
    # operator-controlled value to `https` in the root .env file.
    proxy_set_header X-Forwarded-Proto __GOATFARM_EDGE_PUBLIC_SCHEME__;
    proxy_http_version 1.1;
    # Reject oversized bodies at the edge rather than inside the
    # application. This knob (nginx size units) and the backend's
    # GOATFARM_MAX_REQUEST_BODY_BYTES (bytes) are independent — keep
    # them at the same byte count when you change either. The defaults
    # (1m = 1048576) are equal, and that default correspondence is
    # pinned by test; raising only one still leaves the edge 413ing
    # bodies the other would accept (INFRA-4, 2026-09-16). The edge
    # entrypoint validates and renders this value at startup.
    client_max_body_size __GOATFARM_EDGE_MAX_BODY_SIZE__;
    # INFRA-7 (2026-09-16): no nginx version disclosure on responses
    # or error pages.
    server_tokens off;

    # Security response headers: the application owns the complete set on
    # every proxied response — the next.config.ts baseline (COOP/CORP/
    # Permissions-Policy included) plus the per-request nonce CSP from the
    # frontend's proxy.ts (M-1, 2026-09-20): a nonce policy cannot be
    # emitted here because the edge cannot mint and embed the nonce into
    # the rendered HTML the way the render boundary can. The API sets its
    # own baseline on /api responses. A server-level `add_header ... always`
    # here stamped a second, partial set onto those same proxied responses —
    # duplicate X-Frame-Options/X-Content-Type-Options and a CONFLICTING
    # Referrer-Policy (edge no-referrer vs the SPA's
    # strict-origin-when-cross-origin) on every response (2026-09-28 audit,
    # F1). The edge therefore adds its minimal set ONLY to the responses
    # nginx itself generates: the limit_req 429 (error_page-routed through
    # @auth_flood_rejected below) and /edge-healthz. Upstream-failure pages
    # keep nginx's built-in error bodies, as do the edge's own 413/414
    # (client_max_body_size / URI-length) responses — static nginx bodies
    # with no user content, accepted without the header set (2026-09-29
    # audit NEW-2: the ownership rule is documented for every class). Deployment S3/MinIO origins reach
    # the frontend container as GOATFARM_CSP_IMG_ORIGINS /
    # GOATFARM_CSP_CONNECT_ORIGINS env (validated at edge boot by
    # edge-entrypoint.sh); this template no longer renders them. No HSTS in
    # development — the local edge is deliberately HTTP.

    # nginx resolves a literal upstream name once, at configuration load,
    # and caches that address for the worker's lifetime. Recreating
    # `backend` or `frontend` (any routine redeploy) hands it a new
    # container IP, and Docker's IPAM does not reissue the freed one — so
    # the edge, which compose does not recreate alongside its
    # dependencies, kept proxying to a dead address and 502'd until it
    # was restarted by hand. Naming Docker's embedded DNS server and
    # putting the host in a variable forces re-resolution per request.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Container-local liveness endpoint for the Compose healthcheck:
    # answered by nginx itself (no upstream), reachable only from the
    # container's own loopback. Must sit above `location /` so the SPA
    # proxy does not shadow it. One of the two response types this server
    # generates itself, so it carries the edge's minimal header set (F1).
    location = /edge-healthz {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        allow 127.0.0.1;
        deny all;
        access_log off;
        return 200 "ok\n";
    }

    # No trailing slash (L-1, 2026-09-20 audit): the prefix form matches both
    # /api/auth and /api/auth/..., so the flood zone cannot be skipped by
    # dropping the slash on the exact parent path of every credential route.
    location /api/auth {
        # RT-R-1: applies the zone declared above to the auth family.
        limit_req zone=auth_flood burst=__GOATFARM_EDGE_AUTH_BURST__ nodelay;
        limit_req_status 429;
        # The 429 is generated by nginx, not the app: route it through the
        # named location below so the rejection carries the edge's minimal
        # header set while proxied responses keep only the app's headers
        # (2026-09-28 audit, F1).
        error_page 429 = @auth_flood_rejected;
        # A variable in proxy_pass disables nginx's automatic URI
        # pass-through, so the original URI must be restated;
        # $request_uri is the unmodified request target including its
        # query string, which is what the literal form sent.
        set $backend_upstream backend;
        proxy_pass http://$backend_upstream:8000$request_uri;
    }

    # Edge-generated limit_req rejection. This is the only other place
    # add_header may appear: nginx applies a location's add_header to
    # proxied responses as well, which is exactly the duplication/conflict
    # F1 removes, so proxied locations carry none.
    location @auth_flood_rejected {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        # The backend's 429 convention always carries Retry-After; the edge's
        # own 429 now does too (nginx cannot derive it from limit_req, so a
        # static conservative hint matching the auth window) — a client cannot
        # distinguish the two origins by header presence (2026-09-29 audit).
        add_header Retry-After 300 always;
        return 429 "rate limited\n";
    }
    location /api/ {
        # A variable in proxy_pass disables nginx's automatic URI
        # pass-through, so the original URI must be restated;
        # $request_uri is the unmodified request target including its
        # query string, which is what the literal form sent.
        set $backend_upstream backend;
        proxy_pass http://$backend_upstream:8000$request_uri;
    }
    location / {
        set $frontend_upstream frontend;
        proxy_pass http://$frontend_upstream:3000$request_uri;
    }
}
