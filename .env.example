# Local docker-compose defaults only. Copy this file to .env before running
# `docker compose up`. Replace every credential for a non-local deployment.
# The config-guard preflight validates the env file that actually drove
# Compose interpolation: plain `docker compose up` uses ./.env, and an
# operator overriding with `docker compose --env-file other.env up` must set
# GOATFARM_COMPOSE_ENV_FILE=other.env inside that same file so the guard
# checks the right one (docker-compose.production.yml requires it outright).
# GOATFARM_COMPOSE_ENV_FILE=.env
# Production-only immutable release images (the backend, frontend, and
# hardened nginx edge are all published and signed by release.yml).
# GOATFARM_BACKEND_IMAGE_REPOSITORY=ghcr.io/example/goatfarm-backend
# GOATFARM_BACKEND_IMAGE_DIGEST=sha256:replace-with-release-digest
# GOATFARM_FRONTEND_IMAGE_REPOSITORY=ghcr.io/example/goatfarm-frontend
# GOATFARM_FRONTEND_IMAGE_DIGEST=sha256:replace-with-release-digest
# GOATFARM_EDGE_IMAGE_REPOSITORY=ghcr.io/example/goatfarm-edge
# GOATFARM_EDGE_IMAGE_DIGEST=sha256:replace-with-release-digest
POSTGRES_DB=goatfarm
POSTGRES_USER=goatfarm
# Choose a real secret (and percent-encode it inside the two DATABASE URLs
# below — `:` as %3A, `@` as %40, `/` as %2F). Compose refuses to start with
# this unset; committing a known password here would defeat that guard.
POSTGRES_PASSWORD=
# These are intentionally explicit — docker-compose.yml refuses to render if
# either is missing, so a typo such as GOATFARM_ENVIRONMNET cannot silently
# downgrade this local stack to development. The bundled Postgres is local-only
# and TLS-off; production uses the external verify-full topology in README.
GOATFARM_ENVIRONMENT=development
GOATFARM_DB_SSLMODE=disable
# For a production external database signed by a private CA, mount the PEM
# into migrate/backend/screening-worker and set its in-container absolute path
# in a production deployment override. The local Compose stack does not mount
# CA material because it deliberately refuses production mode.
# GOATFARM_DB_SSLROOTCERT_PATH=/run/secrets/goatfarm-postgres-ca.pem

# Compose gives only the nginx edge an address trusted for X-Forwarded-For.
# If either range conflicts with a host/VPN/network route, choose a different
# unused /24 and an address inside it; the same edge variable configures both
# nginx's address and the backend trust boundary. Changing these on an
# already-created stack (including upgrades across a release that changed the
# defaults from 172.31.243.0/24) requires `docker compose down` once so the
# network is recreated — Compose refuses a live network whose ipam differs.
GOATFARM_DOCKER_SUBNET=198.18.243.0/24
# Database segment (RT-R-2): only the backend and migration job join it —
# the edge and frontend cannot reach the database. Same recreate-on-change
# rule as the subnet above.
GOATFARM_DOCKER_DATA_SUBNET=198.18.244.0/24
GOATFARM_EDGE_PROXY_IP=198.18.243.10
# The Compose edge itself listens on HTTP. When a trusted load balancer or
# reverse proxy terminates public TLS before this edge, set this to `https` so
# absolute API redirects retain the browser's scheme. This is a static operator
# value; nginx never trusts a request's X-Forwarded-Proto header.
GOATFARM_EDGE_PUBLIC_SCHEME=http
# Keep the raw HTTP edge loopback-only. Production must use a trusted TLS
# terminator that proxies to 127.0.0.1:3000 (or reaches edge:3000 over the
# Compose network) and set GOATFARM_EDGE_PUBLIC_SCHEME=https. Do not expose
# this HTTP listener directly to the internet.
GOATFARM_EDGE_BIND_HOST=127.0.0.1
# The edge refuses to start (exit 2) when GOATFARM_EDGE_BIND_HOST names a
# non-loopback address while GOATFARM_ENVIRONMENT is not production. Set this
# to `true` ONLY for an isolated, firewalled staging box where a non-loopback
# development bind is deliberate.
# GOATFARM_ALLOW_DEV_PUBLIC_BIND=true
# Behind an ADDITIONAL outer proxy/load balancer, list every trusted proxy
# address explicitly (the edge IP plus the outer hop); this override wins
# over the edge-IP default above.
# GOATFARM_TRUSTED_PROXY_HOSTS=198.18.243.10,10.0.0.5

# Edge request-body cap (INFRA-4, 2026-09-16): rendered into nginx's
# client_max_body_size. Keep >= GOATFARM_MAX_REQUEST_BODY_BYTES on the backend
# (backend default 1048576 = 1m) — a smaller edge value silently 413s bodies
# the backend would accept.
GOATFARM_EDGE_MAX_BODY_SIZE=1m

# Edge auth flood-zone shaping (P2-15, 2026-09-20): rate and burst nginx
# applies to /api/auth/* only. In production the zone keys on the RIGHTMOST
# X-Forwarded-For entry (the address the trusted TLS terminator appends), so
# every real client gets its own bucket. Raise these at shift-start if
# legitimate logins ever see 429s; grammar is validated at edge boot
# ("<integer>r/s" or "<integer>r/m", burst a non-negative integer).
GOATFARM_EDGE_AUTH_RATE=5r/s
GOATFARM_EDGE_AUTH_BURST=20

# Supply complete SQLAlchemy async URLs instead of asking Compose to splice raw
# credentials into a URL. Percent-encode reserved characters in usernames and
# passwords (for example, `@` as `%40`, `:` as `%3A`, and `/` as `%2F`).
#
# The local example uses PostgreSQL's one bootstrap identity for both jobs
# (set POSTGRES_PASSWORD above and mirror it into both URLs).
# Production must use distinct identities (INFRA-6, 2026-09-16): an API role
# granted only CONNECT/USAGE plus SELECT/INSERT/UPDATE/DELETE on existing
# tables (NO CREATE/ALTER), and a separately protected migration role with
# DDL privileges — e.g.
#   CREATE ROLE goatfarm_api LOGIN PASSWORD '...';
#   CREATE ROLE goatfarm_migrate LOGIN PASSWORD '...';
#   GRANT USAGE ON SCHEMA public TO goatfarm_api;
#   GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA public TO goatfarm_api;
#   GRANT USAGE,SELECT ON ALL SEQUENCES IN SCHEMA public TO goatfarm_api;
#   -- goatfarm_migrate: superuser or CREATE-on-schema + ownership transfer.
# Copying the example's shared bootstrap identity into production leaves the
# API credential able to run DDL — the separation above is the intended state.
# Production also refuses to run Alembic if this migration URL is absent.
GOATFARM_DATABASE_URL=postgresql+asyncpg://goatfarm:CHANGE_ME_GOATFARM@db:5432/goatfarm
GOATFARM_MIGRATION_DATABASE_URL=postgresql+asyncpg://goatfarm:CHANGE_ME_GOATFARM@db:5432/goatfarm
GOATFARM_MIGRATION_STATEMENT_TIMEOUT_MS=900000
# Set true only for the one-shot release after writes are drained when
# Alembic names a pending quiescence-required revision.
GOATFARM_MIGRATION_WRITES_QUIESCED=false
# Production uses a separate least-privilege image-processing role.
GOATFARM_WORKER_DATABASE_URL=postgresql+asyncpg://goatfarm:CHANGE_ME_GOATFARM@db:5432/goatfarm
# Explicitly opt in only for a provisioned shared-tablet deployment. The
# endpoint is otherwise disabled because its display-name roster is public.
GOATFARM_WORKER_ROSTER_ENABLED=false

# Stable secret signing idempotency request fingerprints. The backend's own
# development default is the value below; Compose requires the variable to be
# set explicitly so no deployment silently inherits a publicly-known secret
# from a fallback. Production must replace it (the backend refuses to boot in
# production with any secret shorter than 32 chars or equal to this value).
GOATFARM_IDEMPOTENCY_REQUEST_HMAC_SECRET=development-only-idempotency-hmac-secret-change-me

# Independent AES-256 key for encrypted TOTP shared secrets. Generate an
# unpadded 32-byte base64url value with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# The local compose stack may leave this unset for legacy-compatible dev use;
# docker-compose.production.yml requires it. Before any JWT signing-key
# cutover, set the same value on every API instance and run the documented
# backend/scripts/rekey_totp_secrets.py --apply migration while the old signer
# remains active. Never reuse a JWT, database, password, or HMAC secret.
# GOATFARM_TOTP_ENCRYPTION_KEY=replace-with-43-char-base64url-secret
# GOATFARM_TOTP_ENCRYPTION_PREVIOUS_KEYS=[]

# --- File-delivered production secrets -------------------------------------
# Each service mounts only its own host directory at /run/secrets/app. Create
# mode-0600 files readable by container UID 10001 outside the checkout:
#   api/: database_url, HMAC/TOTP keys, metrics token, storage/provider/MSG91 keys
#   migration/: migration_database_url (DDL role only)
#   worker/: worker_database_url, storage/provider keys (no API or DDL secrets)
# The *_FILE paths below stay unchanged inside each container; duplicate the
# role-appropriate storage/provider files in api/ and worker/ when required.
# Remove a plain secret when enabling its FILE route; the guard rejects both
# routes or missing required DB/HMAC routes. Shell overrides, including empty
# strings that clear an old value, take precedence over this file.
# GOATFARM_APP_SECRET_DIR is retired: preflight refuses it. Split older shared
# directories before rollout; see README's migration checklist. Distinct
# defaults ./secrets/{api,migration,worker} are used for plain-env deployments.
# GOATFARM_API_SECRET_DIR=/secure/goatfarm/api
# GOATFARM_MIGRATION_SECRET_DIR=/secure/goatfarm/migration
# GOATFARM_WORKER_SECRET_DIR=/secure/goatfarm/worker
# GOATFARM_DATABASE_URL_FILE=/run/secrets/app/database_url
# GOATFARM_MIGRATION_DATABASE_URL_FILE=/run/secrets/app/migration_database_url
# GOATFARM_WORKER_DATABASE_URL_FILE=/run/secrets/app/worker_database_url
# GOATFARM_IDEMPOTENCY_REQUEST_HMAC_SECRET_FILE=/run/secrets/app/idempotency_request_hmac_secret
# GOATFARM_TOTP_ENCRYPTION_KEY_FILE=/run/secrets/app/totp_encryption_key
# GOATFARM_S3_ACCESS_KEY_ID_FILE=/run/secrets/app/s3_access_key_id
# GOATFARM_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/app/s3_secret_access_key
# GOATFARM_SCREENING_ANTHROPIC_API_KEY_FILE=/run/secrets/app/screening_anthropic_api_key
# GOATFARM_SCREENING_OPENAI_API_KEY_FILE=/run/secrets/app/screening_openai_api_key
# GOATFARM_MSG91_AUTH_KEY_FILE=/run/secrets/app/msg91_auth_key
# Metrics collection remains enabled in production; public exposition is
# disabled there. A private /metrics scraper must send Authorization: Bearer
# <independent-random-token-at-least-32-characters>. Keep it on the app network.
# GOATFARM_METRICS_ENABLED=true
# GOATFARM_METRICS_BEARER_TOKEN_FILE=/run/secrets/app/metrics_bearer_token

# --- Screening provider timeout / stale-claim horizon (2026-09-28 audit, F3) --
# Both compose files forward this pair to the API AND the screening worker, and
# boot-time cross-validation refuses to start unless the stale horizon covers
# one worst-case cascade: (2 x providers + 6) x the provider timeout. Raise the
# timeout for a slow provider and the horizon must rise with it — tuning only
# one leaves the stack unable to boot.
# GOATFARM_SCREENING_PROVIDER_TIMEOUT_SECONDS=120
# GOATFARM_SCREENING_STALE_PROCESSING_AFTER_SECONDS=1800
# A separate API maintenance saga permanently re-purges raw keys after the
# presigned form's write window closes, including abandoned/invalid uploads.
# GOATFARM_SCREENING_RAW_CLEANUP_INTERVAL_SECONDS=60
# GOATFARM_SCREENING_RAW_CLEANUP_BATCH_SIZE=25
# GOATFARM_SCREENING_RAW_CLEANUP_MAX_BATCHES=4

# --- Data retention sweep (2026-09-28 audit, ITEM 9.1) ------------------------
# Default-on in both Compose topologies and mandatory in production. The sweep
# commits exact-key screening deletion tombstones, verifies versioned object
# absence, and only then finalizes each database chain. Failed/ambiguous work
# stays durable for retry. It also ages operational ledgers in bounded cohorts.
# Weight/feeding records remain.
# GOATFARM_RETENTION_SWEEP_ENABLED=true
# GOATFARM_RETENTION_SWEEP_INTERVAL_SECONDS=86400
# GOATFARM_RETENTION_SCREENING_DAYS=180
# GOATFARM_RETENTION_SCREENING_BATCH_DAYS=365
# GOATFARM_RETENTION_SCREENING_BUDGET_DAYS=90
# GOATFARM_RETENTION_NOTIFICATION_DAYS=400
# GOATFARM_RETENTION_TERMINAL_TASK_DAYS=365
# GOATFARM_RETENTION_DELETE_BATCH_SIZE=500
# GOATFARM_RETENTION_FARM_BATCH_SIZE=100
# GOATFARM_RETENTION_MAX_BATCHES_PER_FARM=4
# GOATFARM_RETENTION_LOCK_TIMEOUT_MS=250
# GOATFARM_RETENTION_STATEMENT_TIMEOUT_MS=5000

# --- Runtime CSP origins (screening photo traffic) -----------------------------
# The disease-check walkthrough POSTs photos straight to the presigned S3 URL
# and displays presigned GET URLs as <img src>. The frontend's per-request
# nonce policy (src/proxy.ts) reads these exact sources at RUNTIME, so generic
# registry frontend images work across deployments; the edge entrypoint
# validates the same values at boot. Set both to the PUBLIC origin of
# GOATFARM_S3_ENDPOINT_URL (MinIO deployments), or — with the endpoint unset
# for AWS S3 proper — to https://<bucket>.s3.<region>.amazonaws.com. Sources
# are space-separated origins (not CSV), must be HTTPS except explicit
# loopback development endpoints, and cannot include paths, credentials, or
# query strings. Leave empty only when screening is disabled; edge startup
# fails closed if screening=true and either list is blank.
# GOATFARM_CSP_CONNECT_ORIGINS=https://minio.example.com
# GOATFARM_CSP_IMG_ORIGINS=https://minio.example.com

# --- Notifications, worker-PIN and screening-budget knobs (dev compose) ---
# The dev compose file (docker-compose.yml) forwards these to the backend so
# notifications/PIN tuning can be exercised locally, exactly like the
# production compose does. Values mirror backend/.env.example — the full,
# authoritative list of backend tunables lives THERE (README → configuration).
# GOATFARM_NOTIFICATIONS_ENABLED=false
# GOATFARM_NOTIFICATIONS_FARM_DAILY_CAP=50
# GOATFARM_NOTIFICATIONS_DIGEST_HOUR=6
# GOATFARM_NOTIFICATIONS_DIGEST_MINUTE=30
# GOATFARM_NOTIFICATIONS_QUIET_START_HOUR=21
# GOATFARM_NOTIFICATIONS_QUIET_END_HOUR=6
# GOATFARM_NOTIFICATIONS_DELIVERY_CONCURRENCY=8
# GOATFARM_NOTIFICATIONS_PER_FARM_DELIVERY_CONCURRENCY=2
# GOATFARM_WORKER_PIN_RATE_LIMIT_MAX_ATTEMPTS=10
# GOATFARM_WORKER_PIN_RATE_LIMIT_WINDOW_SECONDS=300
# GOATFARM_WORKER_PIN_MIN_LENGTH=4
# GOATFARM_MAX_FARMS_PER_USER=10
# GOATFARM_SCREENING_DAILY_CALL_BUDGET_PER_FARM=400
