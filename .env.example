# Local docker-compose defaults only. Copy this file to .env before running
# `docker compose up`. Replace every credential for a non-local deployment.
POSTGRES_DB=goatfarm
POSTGRES_USER=goatfarm
# Choose a real secret (and percent-encode it inside the two DATABASE URLs
# below — `:` as %3A, `@` as %40, `/` as %2F). Compose refuses to start with
# this unset; committing a known password here would defeat that guard.
POSTGRES_PASSWORD=
GOATFARM_ENVIRONMENT=development
GOATFARM_DB_SSLMODE=disable

# Compose gives only the nginx edge an address trusted for X-Forwarded-For.
# If either range conflicts with a host/VPN/network route, choose a different
# unused /24 and an address inside it; the same edge variable configures both
# nginx's address and the backend trust boundary. Changing these on an
# already-created stack (including upgrades across a release that changed the
# defaults from 172.31.243.0/24) requires `docker compose down` once so the
# network is recreated — Compose refuses a live network whose ipam differs.
GOATFARM_DOCKER_SUBNET=198.18.243.0/24
# Database segment (RT-R-2): only the backend and migration job join it —
# the edge and frontend cannot reach the database. Same recreate-on-change
# rule as the subnet above.
GOATFARM_DOCKER_DATA_SUBNET=198.18.244.0/24
GOATFARM_EDGE_PROXY_IP=198.18.243.10
# The Compose edge itself listens on HTTP. When a trusted load balancer or
# reverse proxy terminates public TLS before this edge, set this to `https` so
# absolute API redirects retain the browser's scheme. This is a static operator
# value; nginx never trusts a request's X-Forwarded-Proto header.
GOATFARM_EDGE_PUBLIC_SCHEME=http
# Keep the raw HTTP edge loopback-only. Production must use a trusted TLS
# terminator that proxies to 127.0.0.1:3000 (or reaches edge:3000 over the
# Compose network) and set GOATFARM_EDGE_PUBLIC_SCHEME=https. Do not expose
# this HTTP listener directly to the internet.
GOATFARM_EDGE_BIND_HOST=127.0.0.1
# Behind an ADDITIONAL outer proxy/load balancer, list every trusted proxy
# address explicitly (the edge IP plus the outer hop); this override wins
# over the edge-IP default above.
# GOATFARM_TRUSTED_PROXY_HOSTS=198.18.243.10,10.0.0.5

# Supply complete SQLAlchemy async URLs instead of asking Compose to splice raw
# credentials into a URL. Percent-encode reserved characters in usernames and
# passwords (for example, `@` as `%40`, `:` as `%3A`, and `/` as `%2F`).
#
# The local example uses PostgreSQL's one bootstrap identity for both jobs
# (set POSTGRES_PASSWORD above and mirror it into both URLs).
# Production must use distinct identities: an API role without schema/DDL
# privileges and a separately protected migration role with DDL privileges.
GOATFARM_DATABASE_URL=postgresql+asyncpg://goatfarm:goatfarm@db:5432/goatfarm
GOATFARM_MIGRATION_DATABASE_URL=postgresql+asyncpg://goatfarm:goatfarm@db:5432/goatfarm

# Stable secret signing idempotency request fingerprints. The backend's own
# development default is the value below; Compose requires the variable to be
# set explicitly so no deployment silently inherits a publicly-known secret
# from a fallback. Production must replace it (the backend refuses to boot in
# production with any secret shorter than 32 chars or equal to this value).
GOATFARM_IDEMPOTENCY_REQUEST_HMAC_SECRET=development-only-idempotency-hmac-secret-change-me
